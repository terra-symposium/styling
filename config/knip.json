{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/lib/index.ts",
    "src/ui/index.ts",
    "src/components/ui/index.ts",
    "src/documents/index.ts",
    "src/styles/effects.css",
    "scripts/**/*.cjs",
    "config/tailwind.global.config.mjs",
    "config/tailwind.postcss.config.cjs",
    "docs/styling/**/*.mdx",
    "docs/styling/components/_ComponentTsDocs.tsx",
    "test/**/*.{ts,tsx}",
    "config/**/*.{js,mjs,cjs,ts}"
  ],
  "project": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,mdx}"],
  "ignoreDependencies": [
    "@terra-symposium/styling",
    "@types/bezier-easing",
    "postcss-import",
    "prettier"
  ]
}
