{
	"$schema": "../node_modules/@terra-symposium/hygiene/quality.schema.json",
	"tsconfig": "config/tsconfig.json",
	"sourceRoots": ["."],
	"skippedDirectories": ["node_modules", ".git", ".astro", "dist", "site-dist", "archive/docs-backup", ".agents/skills"],
	"aliases": {
		"@terra-symposium/docs-site-catalog": "node_modules/@terra-symposium/docs/site/src/lib/catalog.ts",
		"@terra-symposium/docs-site-catchall": "node_modules/@terra-symposium/docs/site/src/pages/[...slug].astro"
	},
	"languageProfiles": ["c", "java", "python"],
	"extensions": [
		".astro",
		".c",
		".cjs",
		".cpp",
		".cts",
		".css",
		".h",
		".html",
		".java",
		".js",
		".jsx",
		".json",
		".jsonc",
		".md",
		".mdx",
		".mjs",
		".mts",
		".py",
		".pyi",
		".rs",
		".sh",
		".sql",
		".toml",
		".ts",
		".tsx",
		".yaml",
		".yml"
	],
	"documentation": {
		"required": {
			"functions": true,
			"exportedFunctions": true,
			"types": true,
			"importSection": true,
			"fileHeader": true,
			"multilineTsdoc": true
		},
		"commandRoots": ["."]
	},
	"enabledChecks": {
		"document": true,
		"format": true,
		"import": true,
		"name": true,
		"forward": true,
		"accessibility": true,
		"display-name": true,
		"performance-patterns": true,
		"documented-commands": true,
		"lint": true,
		"knip": true,
		"dead-code": true,
		"type": true,
		"recommend": true,
		"command": true,
		"diff": true,
		"alias": true,
		"security": true,
		"repeated-classes": true,
		"tailwind-canonical": true,
		"regex-dedup": true,
		"ui-patterns": true,
		"ui-recommendations": true,
		"error-boundaries": true,
		"github": true
	},
	"performancePatterns": {
		"extensions": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"]
	},
	"security": {
		"runtimeRoots": ["scripts"],
		"clientRoots": ["site/src", "docs/styling/1-colouring"]
	},
	"github": {
		"repositories": ["Terra-Symposium/styling"]
	},
	"autofix": {
		"document": false
	}
}
