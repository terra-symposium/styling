{
  "name": "@terra-symposium/styling",
  "version": "0.1.28",
  "description": "Shared Terra UI and hue theming",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/docs/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/terra-original": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/lib/tailwind-preset.d.ts",
      "import": "./dist/lib/tailwind-preset.js"
    },
    "./global.css": "./dist/global.css",
    "./ui.css": "./dist/global.css",
    "./effects.css": "./dist/effects.css",
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "import": "./dist/documents/index.js"
    }
  },
  "docs": {
    "title": "Styling",
    "description": "Standardised colouring and components.",
    "site": "https://kaimacann.netlify.app",
    "base": "/styling-docs/",
    "out": "dist/docs",
    "includeAgents": false
  },
  "scripts": {
    "quality": "pnpm run quality:check",
    "quality:fix": "node scripts/terra-quality.mjs quality --all --fix",
    "quality:check": "node scripts/terra-quality.mjs quality --all --warn",
    "build": "node scripts/terra-quality.mjs error-boundaries --all && rm -rf dist && node scripts/generate-component-tsdocs.mjs && tsc -p config/tsconfig.json && mkdir -p dist/assets/fonts/licenses dist/documents && cp src/assets/fonts/*.woff src/assets/fonts/*.woff2 dist/assets/fonts/ && cp src/assets/fonts/README.md dist/assets/fonts/README.md && cp src/assets/fonts/licenses/OFL-1.1.txt dist/assets/fonts/licenses/OFL-1.1.txt && cp src/assets/fonts/licenses/Inter-OFL-1.1.txt dist/assets/fonts/licenses/Inter-OFL-1.1.txt && node scripts/create-document-templates.mjs --package && tailwindcss --postcss config/tailwind.postcss.config.cjs -c config/tailwind.global.config.mjs -i src/styles/global.css -o dist/global.css --minify && node scripts/compile-effects.cjs",
    "typecheck": "tsc --noEmit -p config/tsconfig.json",
    "lint": "eslint --config config/eslint.config.mjs src tests scripts config",
    "knip": "knip --config config/knip.json",
    "docs": "pnpm run build && node scripts/run-docs-site.mjs dev 2030",
    "docs:build": "pnpm run build && node scripts/run-docs-site.mjs build",
    "docs:preview": "pnpm run build && node scripts/run-docs-site.mjs preview 2030",
    "test": "pnpm run build && tsx --test tests/lib/*.test.ts tests/components/ui/*.test.ts",
    "prepare": "husky config/husky"
  },
  "dependencies": {
    "@carbon/icons-react": "11.90.0",
    "@headlessui/tailwindcss": "^0.2.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/typography": "^0.5.12",
    "bezier-easing": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colorjs.io": "^0.5.2",
    "docx": "^9.6.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.555.0",
    "pptxgenjs": "^4.0.1",
    "react-day-picker": "^9.11.1",
    "react-hook-form": "^7.56.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-scrim-gradients": "^0.4.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@terra-symposium/docs": "^0.4.14",
    "@terra-symposium/standards-quality": "2.2.0",
    "@terra-symposium/styling": "0.1.34",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "postcss": "8.5.31",
    "postcss-import": "15.1.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "sideEffects": [
    "./dist/global.css",
    "./dist/effects.css"
  ]
}
