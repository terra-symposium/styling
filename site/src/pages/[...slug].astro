---
import DocsCatchall, { getStaticPaths as getDocsStaticPaths } from '@terra-symposium/docs-site-catchall';

export function getStaticPaths() {
	return [{ params: { slug: undefined }, props: { slug: 'styling' } }, ...getDocsStaticPaths()];
}

const { slug = 'styling' } = Astro.props;
---

<DocsCatchall slug={slug} />
