---
/**
 * site/src/pages/styling/1-colouring/2-components/[component].astro
 */
/*//////////////////////////////////////////////////
IMPORTS
//////////////////////////////////////////////////*/

import DocsSiteLayout from '@terra-symposium/docs/site-layout.astro';
import { pageHref, siteNavigation } from '@terra-symposium/docs-site-catalog';
import { componentTsDocs } from '../../../../../../dist/cache/component-tsdocs.js';
import { ComponentReference } from '../../../../../../docs/styling/1-colouring/components.tsx';

const { component: compRefSlug = '' } = Astro.params;
const docs = componentTsDocs[compRefSlug as keyof typeof componentTsDocs];

export function getStaticPaths() {
	return Object.keys(componentTsDocs).map(c => ({
		params: { component: c },
	}));
}

const base = import.meta.env.BASE_URL;
const title = import.meta.env.PUBLIC_DOCS_TITLE ?? 'Documentation';
const desc = import.meta.env.PUBLIC_DOCS_DESCRIPTION ?? '';
const currentPath = pageHref(`styling/1-colouring/2-components/${compRefSlug}`, base);
---

{docs ? (
	<DocsSiteLayout
		title={title}
		homeHref={pageHref('', base)}
		description={desc}
		pageTitle={docs.title}
		pageDescription={docs.description}
		nodes={siteNavigation}
		currentPath={currentPath}
		rootPath={pageHref('', base)}
		searchBase={base}
	>
		<main class='copy'>
			<ComponentReference client:only='react' component={compRefSlug as keyof typeof componentTsDocs}>
				<p slot='fallback'>Loading component example…</p>
			</ComponentReference>
		</main>
	</DocsSiteLayout>
) : null}
